 AS quintile FROM c)",16]],[0,["SELECT quintile, COUNT(*) AS clients, SUM(revenue) AS revenue,",16]],[0,["       ROUND(100.0*SUM(revenue)/(SELECT SUM(revenue) FROM c),1) AS share_pct",16]],[0,["FROM t GROUP BY quintile ORDER BY quintile;",16]]],"merges":["B2:F2","B1:F1","B3:F3"],"freeze":0,"charts":0},{"name":"Q08","widths":[2.0,26.0,16.0,14.0,14.0,13.0],"rows":[[["",0],["Q08 - Accounts-receivable ageing at 31-Mar-2026",1]],[0,["How much cash is outstanding and how overdue is it?",2]],[0,["Insight: Open receivables total $26.4M; 6.9% is more than 60 days overdue.",11]],[],[0,["Ageing Bucket",3],["Open Invoices",4],["Open Amount",4],["Pct Of Ar",4]],[0,["1. Not yet due",12],["70",13],["$22.2M",13],["83.9",13]],[0,["2. 1-30 days overdue",12],["8",13],["$2.2M",13],["8.4",13]],[0,["3. 31-60 days overdue",12],["1",13],["$187K",13],["0.7",13]],[0,["5. Over 90 days overdue",12],["10",13],["$1.8M",13],["6.9",13]],[],[],[0,["SQL",14],["",15],["",15],["",15],["",15]],[0,["SELECT CASE WHEN julianday('2026-03-31')-julianday(due_date) <= 0  THEN '1. Not yet due'",16]],[0,["            WHEN julianday('2026-03-31')-julianday(due_date) <= 30 THEN '2. 1-30 days overdue'",16]],[0,["            WHEN julianday('2026-03-31')-julianday(due_date) <= 60 THEN '3. 31-60 days overdue'",16]],[0,["            WHEN julianday('2026-03-31')-julianday(due_date) <= 90 THEN '4. 61-90 days overdue'",16]],[0,["            ELSE '5. Over 90 days overdue' END AS ageing_bucket,",16]],[0,["       COUNT(*) AS open_invoices, SUM(invoice_amount) AS open_amount,",16]],[0,["       ROUND(100.0*SUM(invoice_amount)/SUM(SUM(invoice_amount)) OVER (),1) AS pct_of_ar",16]],[0,["FROM sales_transactions WHERE paid_date IS NULL",16]],[0,["GROUP BY ageing_bucket ORDER BY ageing_bucket;",16]]],"merges":["B2:F2","B1:F1","B3:F3"],"freeze":0,"charts":0},{"name":"Q09","widths":[2.0,14.0,16.0,22.0,20.0,19.0,21.0],"rows":[[["",0],["Q09 - DSO and collection performance by fiscal year",1]],[0,["How quickly do we collect, and how mu